---
import Base from '../layouts/Base.astro';
import Sky from '../components/Sky.astro';
import Logo from '../components/Logo.astro';
import FeaturedCard from '../components/FeaturedCard.astro';
import fs from 'node:fs';
import { allProjects, hasNumbers } from '../lib/projects';
import { DOMAINS } from '../lib/domains';
import { v } from '../lib/assetv';

const projects = await allProjects();
const count = projects.filter(hasNumbers).length;
const UPWORK = 'https://www.upwork.com/freelancers/~0101fb6cf6eb992555';
const featured = projects.filter((p) => p.data.featured);
const ORDER = ['edge-ai', 'robot-learning', 'pcb', 'cad', 'other'];
const sorted = [...projects].sort((x, y) => ORDER.indexOf(x.data.domain) - ORDER.indexOf(y.data.domain));
const isVision = (p: (typeof projects)[number]) => p.data.domain === 'edge-ai' || p.data.domain === 'robot-learning';
const benchA = sorted.filter(isVision), benchB = sorted.filter((p) => !isVision(p));
// a wide card covers two cells: 13 cards and 3 wide make 16 cells, 10 and 2 make 12, so every row of four is full
const wideA = new Set([0, 3, 6]), wideB = new Set([0, 3]);
const LAYOUTS = ['wide', 'stack', 'stack', 'wide', 'tile', 'tile'] as const;
// the short figure for a picture-less card: the metric's own `hero`, else its first number and one unit word, never a dangling comma or "of"
const big = (m: { value: string; hero?: string }) => {
  if (m.hero) return m.hero;
  const x = m.value.match(/^(\d[\d.]*%?)(?:\s+(?!and\b|of\b|vs\b|to\b)([A-Za-z]{2,}))?/);
  return x ? [x[1], x[2]].filter(Boolean).join(' ') : m.value.split(/[,;]/)[0].slice(0, 16);
};
const THUMBS = ['cover.webp', 'fallback.webp', 'left02.jpg', 'rollout.gif'];
const thumbOf = (id: string) => { const f = THUMBS.find((n) => fs.existsSync(`public/projects/${id}/${n}`)); return f ? `/projects/${id}/${f}` : null; };
const first = (p: (typeof projects)[number]) => p.data.metrics[0];
type Tool = { name: string; img?: string; w?: number; h?: number; dark?: boolean };
// logos only where an official mark exists in the kit's sources; the rest are plain text chips
const toolGroups: { name: string; items: Tool[] }[] = [
  { name: 'Edge AI and inference', items: [{ img: 'nvidia', w: 40, h: 12, name: 'TensorRT and CUDA' }, { img: 'onnx', w: 40, h: 40, name: 'ONNX Runtime' }, { img: 'qualcomm', w: 40, h: 7, name: 'Qualcomm QNN', dark: true }, { img: 'opencv', w: 32, h: 40, name: 'OpenCV' }, { img: 'gstreamer', w: 40, h: 12, name: 'GStreamer' }] },
  { name: 'ML and robot learning', items: [{ img: 'pytorch', w: 33, h: 40, name: 'PyTorch' }, { img: 'scikitlearn', w: 40, h: 23, name: 'scikit-learn' }, { img: 'hugging-face-icon', w: 40, h: 37, name: 'Hugging Face' }, { name: 'LeRobot' }, { name: 'Stable-Baselines3 and Gymnasium' }, { name: 'MuJoCo' }, { name: 'Isaac Sim' }] },
  { name: 'Hardware and CAD', items: [{ img: 'kicad', w: 40, h: 12, name: 'KiCad' }, { img: 'freecad', w: 34, h: 40, name: 'FreeCAD' }] },
  { name: 'Systems and data', items: [{ img: 'ros', w: 40, h: 11, name: 'ROS 2', dark: true }, { img: 'numpy', w: 37, h: 40, name: 'NumPy' }, { img: 'pandas-icon', w: 25, h: 40, name: 'pandas', dark: true }] },
];
const demoCount = projects.filter((p) => p.data.demo).length;
---
<Base title="Hai Ha: vision and AI engineer, projects with raw numbers" description={`Portfolio of Hai Ha, a vision and AI engineer in Ho Chi Minh City. ${count} public projects with raw numbers, from TensorRT benchmarks and AlphaZero self-play to Diffusion Policy and KiCad boards.`} home>
  <Fragment slot="head">
    <script is:inline>document.documentElement.classList.add('m-enter');setTimeout(function(){document.documentElement.classList.add('m-enter-done')},700)</script>
    <script is:inline src={v("/assets/backgrounds/backgrounds.js")}></script>
    <link rel="stylesheet" href={v("/assets/diagrams/diagram.css")}>
  </Fragment>
  <Fragment slot="plan"><!-- type: software (site-kind software). deal: hero photo layer carrying a three.js foxfire scene (full bleed), nav centre, close word, footer columns, buttons arrow, mark: own fox monogram.
     effect: the nine-tailed foxfire scene behind the hero words (one WebGL context). One moment: word-highlight on the short statement. Motion is the scene, the statement, counts and card hovers. --></Fragment>
  <main id="top">
    <section class="hero hero--photo hero--sky" data-calm="left" data-box="none" data-enter aria-labelledby="hero-h">
      <Sky />
      <div class="wrap"><div class="hero-text">
        <div class="hero__text">
          <a class="portrait" href="/about/" aria-label="About Hai Ha"><img src="/portrait.webp" alt="Portrait of Hai Ha" width="256" height="256" fetchpriority="high"></a>
          <h1 id="hero-h">Hai Ha, vision and AI engineer</h1>
          <p class="hero__lead">I get vision models running correctly and fast on the hardware they ship on.</p>
          <div class="btn-row">
            <a class="btn btn--primary" href="#bench">See the projects<svg class="m-arrow" viewBox="0 0 12 12" aria-hidden="true"><path class="m-arrow__stem" d="M1 6h8"/><path class="m-arrow__head" d="M4.5 2.5 8 6l-3.5 3.5"/></svg></a>
            <a class="btn btn--secondary" href={UPWORK}>Hire me on Upwork</a>
          </div>
        </div>
        <dl class="hero__facts">
          <div><dt>Projects with raw numbers</dt><dd data-m-count>{count}</dd></div>
          <div><dt>Demos in your browser</dt><dd data-m-count>{demoCount}</dd></div>
          <div><dt>Boards in KiCad</dt><dd data-m-count>5</dd></div>
        </dl>
      </div></div>
    </section>

    <section class="section statement" data-moment="word-highlight" aria-label="How I work">
      <div class="wrap">
        <p class="mo-wh__text">I measure before I write. Every project here keeps its <strong>raw numbers</strong>, the commands to reproduce them and a section on what did not work, null results included.</p>
      </div>
    </section>

    <section class="section featured" id="featured" style="--h: 2; --hm: 2" aria-labelledby="featured-h">
      <div class="wrap">
        <div class="section-head"><h2 id="featured-h">Six projects to start with.</h2></div>
        <div class="grid grid--cards fill">
          {featured.slice(0, 6).map((p, i) => <FeaturedCard id={p.id} layout={LAYOUTS[i]} head={p.data.title} line={`${first(p).label}: ${first(p).value}.`} live={p.data.demo?.kind === 'pcb3d' ? { kind: 'pcb3d', ...p.data.demo.props, compact: true } : undefined} />)}
        </div>
      </div>
    </section>

    {[{ id: 'bench', list: benchA, wide: wideA, h: `${benchA.length} projects in vision and robot learning.`, label: 'bench-h' }, { id: 'bench-more', list: benchB, wide: wideB, h: `${benchB.length} more on the bench: boards, CAD and language models.`, label: 'bench-more-h' }].map((sec, k) => (
      <section class="section benchsec" id={sec.id} style="--h: 2; --hm: 2" aria-labelledby={sec.label}>
        <div class="wrap">
          <div class="section-head"><h2 id={sec.label}>{sec.h}</h2></div>
          <ul class="bgrid fill">
            {sec.list.map((p, i) => {
              const th = thumbOf(p.id);
              return (
                <li class={`bcard${sec.wide.has(i) ? ' bcard--wide' : ''}`}>
                  <a class="bcard__thumb" href={`/projects/${p.id}/`} tabindex="-1" aria-hidden="true">
                    {th ? <img src={th} alt="" loading="lazy" width="320" height="200" /> : <span class="bcard__tile"><b>{big(first(p))}</b><i>{first(p).label}</i></span>}
                  </a>
                  <div class="bcard__body">
                    <h3><a href={`/projects/${p.id}/`}>{p.data.title}</a></h3>
                    <p>{first(p).label}: <b>{first(p).value}</b></p>
                    {p.data.demo && <a class="link bench__link" href={`/projects/${p.id}/#demo`}>Run it</a>}
                  </div>
                </li>
              );
            })}
          </ul>
          {k === 1 && <p class="bench__all"><a class="link" href="/projects/">See all projects</a></p>}
        </div>
      </section>
    ))}

    <section class="section tools" id="tools" style="--h: 1; --hm: 1" aria-labelledby="tools-h">
      <div class="wrap">
        <div class="toolhead">
          <div class="section-head"><h2 id="tools-h">The toolbox: TensorRT, PyTorch, KiCad and more.</h2></div>
          <div class="toolhead__visual panel" data-fx="flat"><div class="dg" data-icon-base="/assets/icons/" data-diagram='{"layout":"lanes","alt":"A model trained in PyTorch is exported to ONNX and runs on TensorRT, Qualcomm QNN or OpenCV.","input":{"label":"PyTorch","icon":"pytorch","meta":"train"},"core":{"label":"ONNX","icon":"onnx","meta":"export"},"lanes":[{"label":"TensorRT","icon":"nvidia","meta":"CUDA GPU","done":true},{"label":"QNN","icon":"qualcomm","meta":"NPU","done":true},{"label":"OpenCV","icon":"opencv","meta":"CPU","done":true}]}'></div></div>
        </div>
        <div class="toolgrid fill">
          {toolGroups.map((g) => (
            <div class="toolgroup">
              <div class="toolgroup__body">
              <p class="toolgroup__n">{g.name}</p>
              <ul class="toolrow" style={`--n:${g.items.length}`}>
                {g.items.map((t) => (
                  <li class={t.dark ? 'ic-dark' : undefined}><span class="ic-chip ic-chip--lg">{t.img && <img class={`ic ic-40${(t.h ?? 40) < 16 ? ' ic-wide' : ''}`} src={`/assets/icons/${t.img}.svg`} alt="" width={t.w} height={t.h}>}<span class="ic-name" title={t.name}>{t.name}</span></span></li>
                ))}
              </ul>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>
  </main>
  <script is:inline type="module" src={v("/assets/diagrams/mount.js")}></script>

  <footer class="footer closing" id="contact" aria-labelledby="close-h" slot="footer">
    <div class="wrap">
      <div class="closing__cta">
        <div class="section-head--split">
          <div><h2 id="close-h">Hire me for vision and AI work.</h2><p class="t-lead">Fixed-price jobs on Upwork: edge deployment, TensorRT and ONNX, KiCad boards.</p></div>
          <a class="btn btn--primary" href={UPWORK}>Hire me on Upwork<svg class="m-arrow" viewBox="0 0 12 12" aria-hidden="true"><path class="m-arrow__stem" d="M1 6h8"/><path class="m-arrow__head" d="M4.5 2.5 8 6l-3.5 3.5"/></svg></a>
        </div>
      </div>
      <div class="closing__links">
        <div class="grid">
          <div class="span-5 stack-4">
            <a class="nav__logo" href="#top"><Logo />Hai Ha</a>
            <p class="footer__lede">Vision and AI engineer in Ho Chi Minh City.</p>
          </div>
          <div class="span-3 start-7 footer__col"><h3>Work</h3><ul><li><a href="/projects/">All projects</a></li><li><a href="/about/">About</a></li><li><a href="/quick/">Quick CV</a></li></ul></div>
          <div class="span-3 footer__col"><h3>Elsewhere</h3><ul><li><a href="https://github.com/haiha-ux">GitHub</a></li><li><a href={UPWORK}>Upwork</a></li></ul></div>
        </div>
        <div class="footer__legal">
          <span>&copy; 2026 Hai Ha</span>
          <span class="fine">Fox model by PixelMannen (CC0), rig and animation by tomkranis (CC BY 4.0), via Khronos glTF Sample Assets.</span>
          <button class="numbers" type="button" aria-expanded="false" aria-controls="numbers-note">3 · 9 · 4</button>
          <p class="numbers__note" id="numbers-note" hidden>Life path 3, expression 9, soul 4. Symbols for fun, not science.</p>
        </div>
      </div>
    </div>
  </footer>
</Base>

<script>
  // featured cards: the live demo mounts once, when its card scrolls into view
  import { registry } from '../demos/registry';
  // on a phone the card stays a picture (the full demo is one tap away on the project page)
  if (!matchMedia('(max-width: 639px)').matches) document.querySelectorAll<HTMLElement>('[data-live]').forEach((panel) => {
    const spec = JSON.parse(panel.dataset.live!);
    new IntersectionObserver((es, o) => {
      if (!es[0].isIntersecting) return;
      o.disconnect();
      void registry[spec.kind]().then((m) => m.mount(panel, spec)).catch(() => {});
    }, { rootMargin: '150px' }).observe(panel);
  });
</script>
