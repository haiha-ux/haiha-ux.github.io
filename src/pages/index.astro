---
import Base from '../layouts/Base.astro';
import Sky from '../components/Sky.astro';
import Logo from '../components/Logo.astro';
import FeaturedCard from '../components/FeaturedCard.astro';
import Trace from '../components/Trace.astro';
import { allProjects, hasNumbers } from '../lib/projects';
import { DOMAINS } from '../lib/domains';

const projects = await allProjects();
const count = projects.filter(hasNumbers).length;
const UPWORK = 'https://www.upwork.com/freelancers/~0101fb6cf6eb992555';
const featured = projects.filter((p) => p.data.featured);
const heads: Record<string, string> = {
  'yolo-tensorrt-edge': 'Runs YOLO11n at 1175 FPS',
  'multistream-trt-pipeline': 'Tracks four camera streams live',
  'libero-vla-repro': 'Re-runs two robot policies',
  'alphazero-connect4': 'Trains Connect Four from scratch',
  'pcb-esp32s3-epaper': 'Lays out an e-paper board',
  'diffusion-policy-pusht': 'Pits diffusion against cloning',
};
const tabs: { id: string; label: string; domains: string[] }[] = [
  { id: 'edge', label: 'Edge AI', domains: ['edge-ai'] },
  { id: 'robot', label: 'Robot learning', domains: ['robot-learning'] },
  { id: 'pcb', label: 'PCB and hardware', domains: ['pcb'] },
  { id: 'more', label: 'CAD and other', domains: ['cad', 'other'] },
];
const rowsFor = (domains: string[]) => {
  const list = projects.filter((p) => domains.includes(p.data.domain));
  const half = Math.ceil(list.length / 2);
  return [list.slice(0, half), list.slice(half)];
};
const first = (p: (typeof projects)[number]) => p.data.metrics[0];
const tools = [
  { img: 'pytorch', w: 33, name: 'PyTorch' },
  { img: 'nvidia', w: 40, name: 'TensorRT and CUDA', wide: true },
  { img: 'onnx', w: 40, name: 'ONNX Runtime' },
  { img: 'opencv', w: 32, name: 'OpenCV' },
  { img: 'gstreamer', w: 40, name: 'GStreamer', wide: true },
  { img: 'kicad', w: 40, name: 'KiCad', wide: true },
];
const demoCount = projects.filter((p) => p.data.demo).length;
---
<Base title="Hai Ha: vision and AI engineer, projects with raw numbers" description={`Portfolio of Hai Ha, a vision and AI engineer in Ho Chi Minh City. ${count} public projects with raw numbers, from TensorRT benchmarks to KiCad boards.`} home>
  <Fragment slot="head">
    <script is:inline>document.documentElement.classList.add('m-enter');setTimeout(function(){document.documentElement.classList.add('m-enter-done')},700)</script>
    <script is:inline src="/assets/backgrounds/backgrounds.js"></script>
  </Fragment>
  <Fragment slot="plan"><!-- type: software (site-kind software). deal: hero photo layer carrying a three.js foxfire scene (full bleed), nav centre, close word, footer columns, buttons arrow, mark: own fox monogram.
     effect: the nine-tailed foxfire scene behind the hero words (one WebGL context). No dealt moment: the owner asked for none; motion is the scene, drawn PCB traces, counts and card hovers. --></Fragment>
  <main id="top">
    <section class="hero hero--photo hero--sky" data-calm="left" data-box="none" data-enter aria-labelledby="hero-h">
      <Sky />
      <div class="wrap"><div class="hero-text">
        <div class="hero__text">
          <a class="portrait" href="/about/" aria-label="About Hai Ha"><img src="/portrait.webp" alt="Portrait of Hai Ha" width="256" height="256" fetchpriority="high"></a>
          <h1 id="hero-h">Hai Ha, vision and AI engineer</h1>
          <p class="hero__lead">I get vision models running correctly and fast on the hardware they ship on.</p>
          <div class="btn-row">
            <a class="btn btn--primary" href="#bench">See the projects<svg class="m-arrow" viewBox="0 0 12 12" aria-hidden="true"><path class="m-arrow__stem" d="M1 6h8"/><path class="m-arrow__head" d="M4.5 2.5 8 6l-3.5 3.5"/></svg></a>
            <a class="btn btn--secondary" href={UPWORK}>Hire me on Upwork</a>
          </div>
        </div>
        <dl class="hero__facts">
          <div><dt>Projects with raw numbers</dt><dd data-m-count>{count}</dd></div>
          <div><dt>Demos in your browser</dt><dd data-m-count>{demoCount}</dd></div>
          <div><dt>Boards in KiCad</dt><dd data-m-count>5</dd></div>
        </dl>
      </div></div>
    </section>

    <section class="section g2" id="featured" aria-labelledby="featured-h">
      <Trace variant={0} />
      <div class="wrap">
        <div class="group">
          <div class="section-head"><h2 id="featured-h">Six projects to start with.</h2></div>
          <div class="grid">
            {featured.slice(0, 3).map((p) => <FeaturedCard id={p.id} head={heads[p.id] ?? p.data.title} line={`${first(p).label}: ${first(p).value}.`} />)}
          </div>
        </div>
        <div class="grid">
          {featured.slice(3, 6).map((p) => <FeaturedCard id={p.id} head={heads[p.id] ?? p.data.title} line={`${first(p).label}: ${first(p).value}.`} />)}
        </div>
      </div>
    </section>

    <section class="section" id="bench" style="--hm: 2" aria-labelledby="bench-h">
      <Trace variant={1} />
      <div class="wrap">
        <div class="section-head"><h2 id="bench-h">{projects.length} projects on the lab bench.</h2></div>
        <div class="tabs" role="tablist" aria-label="Filter by trade">
          {tabs.map((t, i) => <button class="tab" role="tab" type="button" id={`tab-${t.id}`} aria-controls={`panel-${t.id}`} aria-selected={i === 0 ? 'true' : 'false'}>{t.label}</button>)}
        </div>
        {tabs.map((t, i) => {
          const [a, b] = rowsFor(t.domains);
          return (
            <div role="tabpanel" id={`panel-${t.id}`} aria-labelledby={`tab-${t.id}`} class="bench" hidden={i !== 0}>
              <div class="grid grid--top">
                {[a, b].map((col) => col.length > 0 && (
                  <ul class="rows span-6">
                    {col.map((p) => (
                      <li>
                        <span class="rows__name"><a class="bench__link" href={`/projects/${p.id}/`}>{p.data.title}</a></span>
                        <p>{first(p).label}: <b>{first(p).value}</b></p>
                        {p.data.demo && <span class="rows__value"><a class="link bench__link" href={`/projects/${p.id}/#demo`}>Run it</a></span>}
                      </li>
                    ))}
                  </ul>
                ))}
              </div>
            </div>
          );
        })}
        <p class="bench__all"><a class="link" href="/projects/">See all projects</a></p>
        <ul class="toolrow" aria-label="Tools I use every day">
          {tools.map((t) => (
            <li><span class="ic-chip ic-chip--lg"><img class={`ic ic-40${t.wide ? ' ic-wide' : ''}`} src={`/assets/icons/${t.img}.svg`} alt="" width={t.w} height={t.wide ? 12 : 40}>{t.name}</span></li>
          ))}
        </ul>
      </div>
    </section>

  </main>

  <footer class="footer closing" id="contact" aria-labelledby="close-h" slot="footer">
    <div class="wrap">
      <div class="closing__cta close--word">
        <div class="section-head--split">
          <div><h2 id="close-h">Hire me for vision and AI work.</h2><p class="t-lead">Fixed-price jobs on Upwork: edge deployment, TensorRT and ONNX, KiCad boards.</p></div>
          <a class="btn btn--primary" href={UPWORK}>Hire me on Upwork<svg class="m-arrow" viewBox="0 0 12 12" aria-hidden="true"><path class="m-arrow__stem" d="M1 6h8"/><path class="m-arrow__head" d="M4.5 2.5 8 6l-3.5 3.5"/></svg></a>
        </div>
        <p class="close__word" aria-hidden="true">Hai Ha</p>
      </div>
      <div class="closing__links">
        <div class="grid">
          <div class="span-5 stack-4">
            <a class="nav__logo" href="#top"><Logo />Hai Ha</a>
            <p class="footer__lede">Vision and AI engineer in Ho Chi Minh City.</p>
          </div>
          <div class="span-3 start-7 footer__col"><h3>Work</h3><ul><li><a href="/projects/">All projects</a></li><li><a href="/about/">About</a></li><li><a href="/quick/">Quick CV</a></li></ul></div>
          <div class="span-3 footer__col"><h3>Elsewhere</h3><ul><li><a href="https://github.com/haiha-ux">GitHub</a></li><li><a href={UPWORK}>Upwork</a></li></ul></div>
        </div>
        <div class="footer__legal">
          <span>&copy; 2026 Hai Ha</span>
          <button class="numbers" type="button" aria-expanded="false" aria-controls="numbers-note">3 · 9 · 4</button>
          <p class="numbers__note" id="numbers-note" hidden>Life path 3, expression 9, soul 4. Symbols for fun, not science.</p>
        </div>
      </div>
    </div>
  </footer>
</Base>
