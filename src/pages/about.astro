---
import Base from '../layouts/Base.astro';
import sky from '../data/sky.json';
import { allProjects, bodyOf } from '../lib/projects';

const projects = await allProjects();
const SIGNS = ['Aries', 'Taurus', 'Gemini', 'Cancer', 'Leo', 'Virgo', 'Libra', 'Scorpio', 'Sagittarius', 'Capricorn', 'Aquarius', 'Pisces'];
const NINE = ['sun', 'moon', 'mercury', 'venus', 'mars', 'jupiter', 'saturn', 'uranus', 'neptune'] as const;
const cap = (s: string) => s[0].toUpperCase() + s.slice(1);
// Chart wheel: Aries starts at 9 o'clock and signs run counter-clockwise, like the wheel of a natal chart.
const C = 250;
const pol = (deg: number, r: number) => {
  const a = ((180 - deg) * Math.PI) / 180;
  return [C + r * Math.cos(a), C - r * Math.sin(a)] as const;
};
const f = (n: number) => n.toFixed(1);
const wedge = (i: number) => {
  const a0 = i * 30, a1 = a0 + 30, r0 = 118, r1 = 212;
  const [x0, y0] = pol(a0, r1), [x1, y1] = pol(a1, r1), [x2, y2] = pol(a1, r0), [x3, y3] = pol(a0, r0);
  return `M${f(x0)} ${f(y0)}A${r1} ${r1} 0 0 0 ${f(x1)} ${f(y1)}L${f(x2)} ${f(y2)}A${r0} ${r0} 0 0 1 ${f(x3)} ${f(y3)}Z`;
};
const readings = SIGNS.map((name, i) => {
  const bodies = NINE.filter((b) => Math.floor((sky as Record<string, number>)[b] / 30) === i);
  const mine = projects.filter((p) => bodies.includes(bodyOf(p) as never));
  const text = mine.length
    ? `${mine.length} project${mine.length > 1 ? 's' : ''}: ${mine.slice(0, 3).map((p) => p.data.title).join('; ')}${mine.length > 3 ? ' and more' : ''}.`
    : bodies.length
    ? `${bodies.map(cap).join(' and ')} here, no project yet.`
    : 'Nothing here.';
  return { name, bodies, mine, text, href: mine[0] ? `/projects/${mine[0].id}/` : null, links: JSON.stringify(mine.map((p) => ({ t: p.data.title, h: `/projects/${p.id}/` }))) };
});
const dots = NINE.map((b) => ({ b, xy: pol((sky as Record<string, number>)[b], 104), main: b === 'sun' || b === 'jupiter' || b === 'neptune' }));
const ticks = Array.from({ length: 72 }, (_, i) => {
  const [x0, y0] = pol(i * 5, i % 6 === 0 ? 222 : 226), [x1, y1] = pol(i * 5, 236);
  return `M${f(x0)} ${f(y0)}L${f(x1)} ${f(y1)}`;
}).join('');
const proj = (id: string) => projects.find((p) => p.id === id)!;
const pl = (...ids: string[]) => ids.map((id) => ({ t: proj(id).data.title, h: `/projects/${id}/` }));
const placements = [
  { n: 'Sun', sign: 'Capricorn', t: 'Tradition reads a durable builder, someone who finishes and keeps measuring until the number holds.', l: pl('yolo-tensorrt-edge') },
  { n: 'Moon', sign: 'Aries', t: 'Tradition reads quick starts: a prototype first, the plan after.', l: pl('marker-alignment-demo') },
  { n: 'Mercury', sign: 'Capricorn', t: 'Tradition reads a structured mind that thinks in checklists and written rules.', l: pl('kicad-review-bench') },
  { n: 'Venus', sign: 'Sagittarius', t: 'Tradition reads a taste for the far and the well made, here as a quiet audio board.', l: pl('pcb-sample-preamp') },
  { n: 'Mars', sign: 'Pisces', t: 'Tradition reads effort that goes around obstacles instead of through them, learned by trial.', l: pl('ppo-mujoco-control') },
  { n: 'Jupiter', sign: 'Cancer', t: 'Tradition reads growth through care for what lasts; here a battery asked to last for years.', l: pl('pcb-lowpower-timer') },
  { n: 'Saturn', sign: 'Gemini', t: 'Tradition reads discipline about reporting and learning: say what you measured, and on what.', l: pl('camera-calibration-report') },
  { n: 'Uranus', sign: 'Aquarius', t: 'Tradition reads the new and the technical, a long way from the usual path.', l: pl('libero-vla-repro') },
  { n: 'Neptune', sign: 'Aquarius', t: 'Tradition reads ideals and unclear edges; hardware files are full of both.', l: pl('pcb-review-crossformat') },
  { n: 'Pluto', sign: 'Sagittarius', t: 'Tradition reads slow, deep change; a long pipeline that is rebuilt until it runs.', l: pl('multistream-trt-pipeline') },
  { n: 'Rising sign', sign: 'Taurus', t: 'Tradition reads the practical one: hardware has to work on the bench, not only on a slide.', l: pl('pcb-esp32s3-epaper') },
];
const palaces = [
  { n: 'Mệnh', e: 'Life', stars: 'Thiên Cơ', t: 'The planner star: tactics, engineering, a slow start. Tradition reads a careful mind that matures late.', l: pl('ros2-trt-detector') },
  { n: 'Huynh đệ', e: 'Siblings', stars: '', t: 'The palace of siblings and close peers. No main star is read here.', l: [] },
  { n: 'Phu thê', e: 'Partner', stars: 'Nhật Lương (bright), Hoá Quyền, Văn Xương Hoá Kỵ', t: 'Standing and authority rise, while paperwork and contracts are read as easy to get wrong.', l: pl('pcb-review-crossformat') },
  { n: 'Tử tức', e: 'Children', stars: 'Vũ Khúc, Thiên Tướng', t: 'Stars of the doer who earns by executing. Read for what one makes and ships.', l: pl('vla-lora-finetune') },
  { n: 'Tài bạch', e: 'Wealth', stars: 'Đồng Cự, Hoá Lộc', t: 'Gain through talk and steady work; the Lộc mark is read as reward for effort.', l: pl('kicad-review-bench') },
  { n: 'Tật ách', e: 'Health', stars: '', t: 'The palace of health and body. No main star is read here.', l: [] },
  { n: 'Thiên di', e: 'Travel', stars: 'Thái Âm, Văn Khúc Hoá Khoa, Thiên Mã', t: 'Away from home: study, movement and a name that carries. Opportunity is read as coming from outside.', l: pl('llm-continual-books') },
  { n: 'Nô bộc', e: 'Colleagues', stars: 'Liêm Trinh, Thiên Phủ', t: 'Strong colleagues and juniors, with some friction. Tradition reads good help that needs handling.', l: [] },
  { n: 'Quan lộc', e: 'Career', stars: 'Empty palace, borrows Nhật Lương from the opposite; Lộc tồn', t: 'Career as a store of steady value: build things that last. The borrowed star is the one in Partner.', l: pl('multistream-trt-pipeline') },
  { n: 'Điền trạch', e: 'Home', stars: 'Phá Quân', t: 'Fixed assets are read as changing hands; things are rebuilt rather than inherited. A floor plan redrawn from a scan fits.', l: pl('cad-sample-tests') },
  { n: 'Phúc đức', e: 'Fortune & Virtue', stars: 'Empty palace, borrows Đồng Cự from the opposite (body palace)', t: 'The inner life is disciplined and under some pressure; it shows as self-set rules. The body palace sits here.', l: pl('ppo-mujoco-control') },
  { n: 'Phụ mẫu', e: 'Parents', stars: '', t: 'The palace of parents and teachers. No main star is read here.', l: [] },
];
const numbers = [
  { v: 3, name: 'Life path', how: 'Tradition reads creation and expression, with a risk of scattering. On the site: three facts in the hero, and the 3 in the footer mark.' },
  { v: 9, name: 'Expression', how: 'Ha Phan Thanh Hai: 40 + 4 + 7 + 10 + 2 + 9 = 72, then 7 + 2. Tradition reads the closing of a cycle. On the site: the nine tails of the fox.' },
  { v: 4, name: 'Soul urge', how: 'The vowels of the name: 4 + 9 = 13, then 1 + 3. Tradition reads structure and a steady base. On the site: the raw numbers left in every project.' },
  { v: 5, name: 'Personality', how: 'The consonants: 40 + 7 + 10 + 2 = 59, then 5 + 9 = 14, then 1 + 4. Tradition reads change and range. On the site: five KiCad boards in the hero.' },
  { v: 1, name: 'Personal year 2026', how: 'Tradition reads a year of beginnings, the first of a nine-year cycle. This site went live in 2026.' },
];
---
<Base title="About: Hai Ha, vision and AI engineer" description="Hai Ha works on perception for UAVs and on getting vision models to run correctly and fast on real hardware. Notes on the work, and a 12-sign dial of the projects." current="about">
  <main id="top" class="page">
    <div class="wrap">
      <div class="page__head">
        <h1>I get vision models running on the hardware they ship on.</h1>
      </div>
      <div class="about">
        <div class="prose">
          <figure class="about-photo"><img src="/portrait-lg-800.webp" srcset="/portrait-lg-480.webp 480w, /portrait-lg-800.webp 800w" sizes="(max-width: 899px) 100vw, 520px" alt="Hai standing in a pine forest, looking down, in a dark jacket" width="800" height="942" loading="eager" fetchpriority="high"></figure>
          <p>I am Hai, an engineer in Ho Chi Minh City. At my day job I work on perception for UAVs: multi-camera fisheye calibration, depth for obstacle avoidance and quantized models on Qualcomm NPUs. I am also doing an M.Eng. in electronics at Ho Chi Minh City University of Technology. Friends call me Cáo, the fox.</p>
          <p>The repos on this site are things I built to measure something properly. Each one has the raw numbers, the commands to reproduce them and a section on what did not work. Several of those sections report a null result, and I left them in.</p>
          <p>In 2026 I was the AI engineer on a city-scale drone pilot for traffic and urban-order monitoring in Hanoi, covered by <a class="link" href="https://news.laodong.vn/xa-hoi/tuan-tra-bang-uav-buoc-tien-huong-toi-do-thi-an-toan-hien-dai-1742963.ldo">Lao Động</a> and <a class="link" href="https://anninhthudo.vn/cong-an-ha-noi-tuan-tra-bang-uav-make-in-viet-nam-dot-pha-quan-tri-giao-thong-va-trat-tu-do-thi-post660666.antd">An ninh Thủ đô</a>. I also co-authored MARS, a small multi-task Mamba model for mapless UAV navigation (IAAA 2026, Springer LNNS).</p>
          <p>Day to day I use Python and C++, PyTorch, TensorRT, ONNX Runtime, OpenCV, CUDA, GStreamer, ROS 2 and KiCad.</p>
          <p class="cv-links"><a class="btn btn--primary" href="https://www.upwork.com/freelancers/~0101fb6cf6eb992555">Hire me on Upwork</a><a class="btn btn--secondary" href="/quick/">Read the quick CV</a></p>
        </div>
        <div class="lenses">
          <h2 class="lenses__title">Three lenses</h2>
          <p class="fine">Symbols for fun, not science. Each lens is a way to read the projects, nothing more. Tradition says what it says; the projects are real either way.</p>
          <div class="seg" role="tablist" aria-label="Three lenses">
            <button class="seg__b" role="tab" id="lens-t1" aria-controls="lens-p1" aria-selected="true" type="button">Astrology</button>
            <button class="seg__b" role="tab" id="lens-t2" aria-controls="lens-p2" aria-selected="false" tabindex="-1" type="button">Tử vi</button>
            <button class="seg__b" role="tab" id="lens-t3" aria-controls="lens-p3" aria-selected="false" tabindex="-1" type="button">Numbers</button>
          </div>
          <div class="lens" role="tabpanel" id="lens-p1" aria-labelledby="lens-t1">
        <div class="dial">
          <svg viewBox="0 0 500 500" role="group" aria-label="A dial with 12 signs; each shows the projects on its tails">
            <g class="dial__ring" aria-hidden="true">
              <circle cx="250" cy="250" r="240" fill="none" stroke="var(--accent)" stroke-width="3" />
              <circle cx="250" cy="250" r="219" fill="none" stroke="var(--accent)" stroke-opacity=".5" />
              <path d={ticks} stroke="var(--accent)" stroke-width="1.4" fill="none" />
            </g>
            <circle cx="250" cy="250" r="114" fill="none" stroke="var(--steel)" stroke-opacity=".35" />
            {readings.map((r, i) => (
              <a class="dial__a" href={r.href ?? '#dial-read'} data-read={r.text} data-sign={r.name} data-links={r.links} aria-label={`${r.name}. ${r.text}`}>
                <path class="dial__cell dial__sign" d={wedge(i)} />
                <text x={f(pol(i * 30 + 15, 188)[0])} y={f(pol(i * 30 + 15, 188)[1] + 4)} text-anchor="middle" fill="var(--steel)" font-family="var(--font-mono)" font-size="13">{r.name.slice(0, 3)}</text>
              </a>
            ))}
            {dots.map((d) => <circle cx={f(d.xy[0])} cy={f(d.xy[1])} r={d.main ? 6 : 3.5} fill={d.main ? 'var(--accent)' : 'var(--steel)'} />)}
          </svg>
          <p class="dial__read" id="dial-read" aria-live="polite"><b>Pick a sign.</b> The dial places the nine tails of the hero constellation by their positions in a birth chart.</p>
        </div>
        <ul class="reads" aria-label="Placements and what tradition reads in them">
          {placements.map((x) => (
            <li class="read"><b class="read__n">{x.n}<span> in {x.sign}</span></b><span class="read__t">{x.t}</span>{x.l.map((k) => <a class="link read__l" href={k.h}>{k.t}</a>)}</li>
          ))}
        </ul>
          </div>
          <div class="lens" role="tabpanel" id="lens-p2" aria-labelledby="lens-t2" hidden>
            <p class="fine">Twelve palaces of a Tử vi chart, main stars only. Pick a palace, or move between them with the arrow keys. The body palace sits in Fortune &amp; Virtue.</p>
            <ul class="palaces" role="group" aria-label="Twelve palaces">
              {palaces.map((x, i) => (
                <li class="palace">
                  <button class="palace__b" type="button" aria-pressed={i === 0 ? 'true' : 'false'} aria-controls="palace-read" data-n={x.n} data-e={x.e} data-stars={x.stars} data-text={x.t} data-links={JSON.stringify(x.l)}><b>{x.n}</b><i>{x.e}</i></button>
                </li>
              ))}
            </ul>
            <div class="palace__read" id="palace-read" aria-live="polite"></div>
          </div>
          <div class="lens" role="tabpanel" id="lens-p3" aria-labelledby="lens-t3" hidden>
            <ul class="nums">
              {numbers.map((n) => (
                <li class="num"><b class="num__v" data-to={n.v} aria-label={String(n.v)}>{n.v}</b><span class="num__n">{n.name}</span><span class="num__h">{n.how}</span></li>
              ))}
            </ul>
            <p class="fine">The sums use the Pythagorean letter table. The birth date behind the life path stays private.</p>
          </div>
        </div>
      </div>
    </div>
  </main>
</Base>
<script>
  // hovering or focusing a sign lights its arc and lists the projects that sit on it, as links
  const read = document.getElementById('dial-read')!;
  const cells = document.querySelectorAll<SVGAElement>('.dial__a');
  const show = (a: SVGAElement) => {
    cells.forEach((c) => c.classList.toggle('is-on', c === a));
    const links: { t: string; h: string }[] = JSON.parse(a.dataset.links || '[]');
    read.replaceChildren();
    const b = document.createElement('b');
    b.textContent = `${a.dataset.sign}. `;
    read.append(b, a.dataset.read ?? '');
    if (links.length) {
      const ul = document.createElement('ul');
      ul.className = 'dial__list';
      links.slice(0, 5).forEach((l) => { const li = document.createElement('li'); const x = document.createElement('a'); x.className = 'link'; x.href = l.h; x.textContent = l.t; li.append(x); ul.append(li); });
      read.append(ul);
    }
  };
  cells.forEach((a) => { a.addEventListener('pointerenter', () => show(a)); a.addEventListener('focus', () => show(a)); });
  const ring = document.querySelector('.dial__ring');
  ring?.addEventListener('pointerenter', () => ring.classList.add('is-paused'));

  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;

  // Tử vi palaces: the pressed one writes its stars, reading and projects; arrows move through the grid
  const palRead = document.getElementById('palace-read')!;
  const pals = [...document.querySelectorAll<HTMLButtonElement>('.palace__b')];
  const palShow = (b: HTMLButtonElement) => {
    pals.forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
    palRead.replaceChildren();
    const h = document.createElement('b'); h.textContent = `${b.dataset.n}, ${b.dataset.e}. `;
    palRead.append(h);
    if (b.dataset.stars) { const em = document.createElement('em'); em.textContent = `${b.dataset.stars}. `; palRead.append(em); }
    palRead.append(b.dataset.text ?? '');
    const links = JSON.parse(b.dataset.links || '[]') as { t: string; h: string }[];
    if (links.length) {
      const ul = document.createElement('ul'); ul.className = 'dial__list';
      links.forEach((l) => { const li = document.createElement('li'); const a = document.createElement('a'); a.className = 'link'; a.href = l.h; a.textContent = l.t; li.append(a); ul.append(li); });
      palRead.append(ul);
    }
    palRead.classList.remove('is-in'); void palRead.offsetWidth; palRead.classList.add('is-in');
  };
  palShow(pals[0]);
  const cols = () => (innerWidth < 480 ? 3 : 4);
  pals.forEach((b, i) => {
    b.addEventListener('click', () => palShow(b));
    b.addEventListener('pointerenter', (e) => { if (e.pointerType === 'mouse') palShow(b); });
    b.addEventListener('keydown', (e) => {
      const j = e.key === 'ArrowRight' ? i + 1 : e.key === 'ArrowLeft' ? i - 1 : e.key === 'ArrowDown' ? i + cols() : e.key === 'ArrowUp' ? i - cols() : -1;
      if (j < 0 || j >= pals.length) return;
      e.preventDefault(); pals[j].focus(); palShow(pals[j]);
    });
  });

  // the numbers count up when their panel opens
  const count = () => document.querySelectorAll<HTMLElement>('.num__v').forEach((el) => {
    const to = Number(el.dataset.to);
    if (reduce) { el.textContent = String(to); return; }
    const t0 = performance.now();
    const step = (now: number) => { const k = Math.min(1, (now - t0) / 900); el.textContent = String(Math.round(to * (1 - Math.pow(1 - k, 3)))); if (k < 1) requestAnimationFrame(step); };
    requestAnimationFrame(step);
  });

  // lens tabs: arrow keys, Home and End move between them
  const tabs = [...document.querySelectorAll<HTMLButtonElement>('.seg__b')];
  const pick = (t: HTMLButtonElement) => {
    tabs.forEach((x) => {
      const on = x === t;
      x.setAttribute('aria-selected', String(on)); x.tabIndex = on ? 0 : -1;
      const panel = document.getElementById(x.getAttribute('aria-controls')!)!;
      panel.hidden = !on;
    });
    if (t.id === 'lens-t3') count();
  };
  tabs.forEach((t, i) => {
    t.addEventListener('click', () => pick(t));
    t.addEventListener('keydown', (e) => {
      const j = e.key === 'ArrowRight' ? (i + 1) % 3 : e.key === 'ArrowLeft' ? (i + 2) % 3 : e.key === 'Home' ? 0 : e.key === 'End' ? 2 : -1;
      if (j < 0) return;
      e.preventDefault(); tabs[j].focus(); pick(tabs[j]);
    });
  });
</script>
