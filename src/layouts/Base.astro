---
import Logo from '../components/Logo.astro';
interface Props { title: string; description: string; current?: 'projects' | 'bench' | 'about' | 'cv'; home?: boolean; image?: string }
const { title, description, current, home = false, image = '/share.jpg' } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const img = new URL(image, Astro.site).href;
const UPWORK = 'https://www.upwork.com/freelancers/~0101fb6cf6eb992555';
---
<!doctype html>
<html lang="en" data-type="software" data-radius="sharp" data-buttons="arrow" data-motion>
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>{title}</title>
<meta name="description" content={description}>
<meta property="og:type" content="website">
<meta property="og:title" content={title}>
<meta property="og:description" content={description}>
<meta property="og:image" content={img}>
<meta name="twitter:card" content="summary_large_image">
<link rel="icon" href="/favicon.svg" type="image/svg+xml">
<meta name="theme-color" content="#14120f">
<link rel="canonical" href={canonical}>
<meta name="site-kind" content="software">
<meta name="page-type" content="software">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Geist:wght@400..700&family=Geist+Mono:wght@400..500&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/assets/system.css">
<link rel="stylesheet" href="/assets/ui/cards.css">
<link rel="stylesheet" href="/assets/motion/motion.css">
<link rel="stylesheet" href="/assets/backgrounds/backgrounds.css">
<link rel="stylesheet" href="/assets/layout/layout.css">
<link rel="stylesheet" href="/assets/icons/icon.css">
<style is:inline>
:root {
  --p-bg: #14120f; --p-surface: #1f1b16; --p-ink: #efe7d6; --p-muted: #a39a8a;
  --p-accent: #d9ae55; --p-accent-ink: #14120f; --p-action: #d9ae55; --p-action-ink: #14120f;
  --p-inv-bg: #efe7d6; --p-inv-surface: #ddd6c6; --p-inv-ink: #14120f; --p-inv-muted: #5e5952;
  --p-inv-accent: #14120f; --p-inv-accent-ink: #efe7d6; --p-inv-action: #14120f; --p-inv-action-ink: #efe7d6;
  --font-display: "Geist", system-ui, sans-serif;
  --font-text: "Geist", system-ui, sans-serif;
  --font-mono: "Geist Mono", ui-monospace, "SFMono-Regular", Menlo, Consolas, monospace;
  --display-weight: 500;
  --display-tracking: -0.035em;
  --display-tracking-xl: -0.045em;
  --steel: #9db2bc;
}
</style>
<link rel="stylesheet" href="/site.css">
<slot name="head" />
</head>
<body>
<slot name="plan" />
<header class="nav nav--centre">
  <div class="wrap nav__bar">
    <a class="skip-link" href="#top">Skip to content</a>
    <a class="nav__logo" href="/" aria-label="Hai Ha, home"><Logo />Hai Ha</a>
    <nav class="nav__links" aria-label="Main">
      <div class="nav__item"><a class="nav__link" href="/projects/" aria-current={current === 'projects' ? 'page' : undefined}>Projects</a></div>
      <div class="nav__item"><a class="nav__link" href="/#bench">Lab bench</a></div>
      <div class="nav__item"><a class="nav__link" href="/about/" aria-current={current === 'about' ? 'page' : undefined}>About</a></div>
      <div class="nav__item"><a class="nav__link" href="/quick/" aria-current={current === 'cv' ? 'page' : undefined}>Quick CV</a></div>
    </nav>
    <div class="nav__actions">
      <a class="btn btn--primary" href={home ? '#bench' : '/#bench'}>See the projects</a>
    </div>
    <button class="nav__toggle" type="button" aria-expanded="false" aria-label="Menu">
      <svg width="18" height="18" viewBox="0 0 18 18" aria-hidden="true"><path d="M2 5h14M2 13h14" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
    </button>
  </div>
</header>
<slot />
<slot name="footer">
<footer class="footer footer--page">
  <div class="wrap">
    <div class="grid">
      <div class="span-5 stack-4">
        <a class="nav__logo" href="/"><Logo />Hai Ha</a>
        <p class="footer__lede">Vision and AI engineer in Ho Chi Minh City.</p>
      </div>
      <div class="span-3 start-7 footer__col"><h3>Work</h3><ul><li><a href="/projects/">All projects</a></li><li><a href="/about/">About</a></li><li><a href="/quick/">Quick CV</a></li></ul></div>
      <div class="span-3 footer__col"><h3>Elsewhere</h3><ul><li><a href="https://github.com/haiha-ux">GitHub</a></li><li><a href={UPWORK}>Upwork</a></li></ul></div>
    </div>
    <div class="footer__legal">
      <span>&copy; 2026 Hai Ha</span>
      <button class="numbers" type="button" aria-expanded="false" aria-controls="numbers-note">3 · 9 · 4</button>
      <p class="numbers__note" id="numbers-note" hidden>Life path 3, expression 9, soul 4. Symbols for fun, not science.</p>
    </div>
  </div>
</footer>
</slot>
<script is:inline>
document.querySelectorAll('.numbers').forEach(function (b) {
  b.addEventListener('click', function () {
    var n = document.getElementById(b.getAttribute('aria-controls'));
    var open = b.getAttribute('aria-expanded') === 'true';
    b.setAttribute('aria-expanded', String(!open));
    if (n) n.hidden = open;
  });
});
</script>
<script is:inline type="module" src="/assets/system.js"></script>
<script is:inline type="module" src="/assets/motion/motion.js"></script>
{home && <script is:inline type="module" src="/assets/layout/layout.js"></script>}
<script is:inline>
(function () {
  var t = document.querySelectorAll('.trace');
  if (!t.length) return;
  if (!('IntersectionObserver' in window)) return;
  document.documentElement.classList.add('js-trace');
  var io = new IntersectionObserver(function (es) {
    es.forEach(function (e) { if (e.isIntersecting) { e.target.classList.add('is-drawn'); io.unobserve(e.target); } });
  }, { threshold: 0.2 });
  t.forEach(function (n) { io.observe(n); });
})();
</script>
<slot name="scripts" />
</body>
</html>
