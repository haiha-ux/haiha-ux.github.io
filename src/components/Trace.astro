---
// A PCB trace on 45 degree bends that draws itself once when its section comes into view (see site.css .trace).
const { variant = 0 } = Astro.props as { variant?: number };
const paths = [
  'M0 40H300L340 80H760L800 40H1440',
  'M1440 40H1100L1060 80H620L580 40H0',
  'M0 80H240L280 40H900L940 80H1440',
];
const pads: [number, number][][] = [[[300, 40], [800, 40], [1440, 40]], [[1100, 40], [580, 40], [0, 40]], [[240, 80], [940, 80], [1440, 80]]];
---
<svg class="trace" viewBox="-12 0 1464 120" preserveAspectRatio="none" aria-hidden="true" focusable="false">
  <path d={paths[variant % 3]} pathLength="1" />
  {pads[variant % 3].map(([x, y]) => <circle cx={x} cy={y} r="5" />)}
</svg>
