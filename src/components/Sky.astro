---
import { DOMAINS } from '../lib/domains';
import { TAILS, MAIN_TAILS, tailPoint, layoutOrbs, orbPos, projectStill, type OrbIn } from '../lib/foxsky';
import { allProjects, bodyOf } from '../lib/projects';

const projects = await allProjects();
const orbIn: OrbIn[] = projects.map((p) => ({
  slug: p.id,
  title: p.data.title,
  domain: p.data.domain,
  body: bodyOf(p),
  metric: p.data.metrics[0] ? `${p.data.metrics[0].label}: ${p.data.metrics[0].value}` : '',
  featured: p.data.featured,
  order: p.data.order,
}));
const orbs = layoutOrbs(orbIn);

// Still views: a 1440x900 hero and a 390x355 phone strip, same geometry as the live scene at rest.
const VIEWS = [
  { id: 'wide', aspect: 1440 / 900 },
  { id: 'tall', aspect: 390 / 355 },
];
const W = 1000;
const views = VIEWS.map((v) => {
  const H = W / v.aspect;
  const P = (p: [number, number, number]) => { const [x, y] = projectStill(p, v.aspect); return [(x / 100) * W, (y / 100) * H] as [number, number]; };
  return { ...v, H, orbPts: orbs.map((o) => ({ o, xy: P(orbPos(o)) })) };
});
const labels = Object.entries(MAIN_TAILS).map(([domain, body]) => {
  const t = TAILS.find((x) => x.body === body)!;
  const at = (v: (typeof views)[number]) => {
    const [x, y] = projectStill(tailPoint(t, 1.0), v.aspect);
    return [x, y] as [number, number];
  };
  return { body, domain: domain as keyof typeof DOMAINS, wide: at(views[0]), tall: at(views[1]) };
});
const pct = (xy: [number, number], H: number) => `${(xy[0] / W * 100).toFixed(2)}%`;
const pcty = (xy: [number, number], H: number) => `${(xy[1] / H * 100).toFixed(2)}%`;
const payload = JSON.stringify(orbs.map((o) => ({ slug: o.slug, title: o.title, domain: o.domain, body: o.body, metric: o.metric, featured: o.featured, order: o.order })));
---
<div class="sky hero__bg" id="sky" data-sky data-orbs={payload}>
  <div class="sky__still" aria-hidden="true">
    <img class="sky__svg sky__svg--wide" src="/sky-wide.webp" alt="" width="1440" height="900" decoding="async">
    <img class="sky__svg sky__svg--tall" src="/sky-tall.webp" alt="" width="390" height="355" decoding="async">
  </div>
  <ul class="sky__stars" aria-label="Projects on the constellation">
    {views[0].orbPts.map(({ o }, i) => (
      <li class="sky__li" style={`--xd:${pct(views[0].orbPts[i].xy, views[0].H)};--yd:${pcty(views[0].orbPts[i].xy, views[0].H)};--xt:${pct(views[1].orbPts[i].xy, views[1].H)};--yt:${pcty(views[1].orbPts[i].xy, views[1].H)}`} data-slug={o.slug}>
        <a class="sky__star" href={`/projects/${o.slug}/`} data-domain={o.domain} aria-label={o.metric ? `${o.title}: ${o.metric}` : o.title}>
          <span class="sky__tip" aria-hidden="true"><b>{o.title}</b><span>{o.metric}</span><em>{DOMAINS[o.domain as keyof typeof DOMAINS]}</em></span>
        </a>
      </li>
    ))}
  </ul>
  <ul class="sky__labels" aria-hidden="true">
    {labels.map((l) => <li class="sky__label" data-body={l.body} style={`--xd:${l.wide[0].toFixed(2)}%;--yd:${l.wide[1].toFixed(2)}%;--xt:${l.tall[0].toFixed(2)}%;--yt:${l.tall[1].toFixed(2)}%`}>{DOMAINS[l.domain]}</li>)}
  </ul>
  <button class="sky__pause" type="button" aria-pressed="false" hidden>Pause motion</button>
</div>
<script>
  // three.js and the fox are fetched only once the hero is on screen, never before first paint; the PNG poster is the picture until then.
  // Desktop: after the browser is idle. Phone (<= 768px): after the first touch, scroll or key, or 2.5 s after load. Reduced motion: never.
  const sky = document.querySelector<HTMLElement>('[data-sky]');
  if (sky && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
    let started = false;
    const start = () => { if (started) return; started = true; import('../scene/foxfire').then((m) => m.mount(sky)).catch(() => sky.classList.add('is-still')); };
    const idle = () => ((window as any).requestIdleCallback ? (window as any).requestIdleCallback(start, { timeout: 1200 }) : setTimeout(start, 400));
    // hovering or focusing "See the projects" (Base.astro) asks for the fox early
    let onScreen = false;
    document.addEventListener('fox-warm', () => { if (onScreen) start(); });
    const arm = () => {
      if (!matchMedia('(max-width: 768px)').matches) return idle();
      const evs = ['pointerdown', 'touchstart', 'scroll', 'keydown'];
      let t: number;
      const go = () => { evs.forEach((e) => removeEventListener(e, go)); clearTimeout(t); idle(); };
      evs.forEach((e) => addEventListener(e, go, { passive: true }));
      const wait = () => { t = window.setTimeout(go, 2500); };
      document.readyState === 'complete' ? wait() : addEventListener('load', wait, { once: true });
    };
    let armed = false;
    new IntersectionObserver(([en]) => { onScreen = en.isIntersecting; if (onScreen && !armed) { armed = true; arm(); } }).observe(sky);
  }
</script>
