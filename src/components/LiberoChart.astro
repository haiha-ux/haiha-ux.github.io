---
// Wilson 95% intervals from libero-vla-repro (100 episodes each), drawn as a static still of the data in the README.
const rows = [
  { name: 'SmolVLA 0.6B', p: 66, lo: 56.3, hi: 74.5 },
  { name: 'SmolVLA 0.45B', p: 63, lo: 53.2, hi: 71.8 },
  { name: 'pi0-FAST', p: 79, lo: 70.0, hi: 85.8 },
];
const x = (v: number) => 150 + (v - 40) * 11;
---
<svg class="lib" viewBox="0 0 800 292" role="img" aria-label="Success rates on LIBERO-Spatial with 95 percent intervals: SmolVLA 0.6B 66, SmolVLA 0.45B 63, pi0-FAST 79 out of 100" focusable="false">
  <g class="lib__grid">{[40, 50, 60, 70, 80, 90].map((v) => <><line x1={x(v)} x2={x(v)} y1="28" y2="240" /><text x={x(v)} y="266" text-anchor="middle">{v}%</text></>)}</g>
  {rows.map((r, i) => (
    <g>
      <text class="lib__name" x="140" y={74 + i * 68} text-anchor="end">{r.name}</text>
      <line class="lib__ci" x1={x(r.lo)} x2={x(r.hi)} y1={68 + i * 68} y2={68 + i * 68} />
      <line class="lib__cap" x1={x(r.lo)} x2={x(r.lo)} y1={58 + i * 68} y2={78 + i * 68} />
      <line class="lib__cap" x1={x(r.hi)} x2={x(r.hi)} y1={58 + i * 68} y2={78 + i * 68} />
      <circle class="lib__dot" cx={x(r.p)} cy={68 + i * 68} r="7" />
    </g>
  ))}
</svg>
